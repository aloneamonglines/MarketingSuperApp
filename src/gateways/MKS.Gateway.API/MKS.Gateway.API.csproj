<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/Resources/*.json">
      <LogicalName>$(RootNamespace).Localization.Resources.GatewayResource.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Remove="Localization/Resources/*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\MKS.Shared.Host\MKS.Shared.Host.csproj" />
  </ItemGroup>

</Project>
