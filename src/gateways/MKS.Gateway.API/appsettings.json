{
  "Identity": {
    "Authority": "https://identity.example.com/"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "identity-api": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "identity-openid": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      },
      "identity-discovery": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-api": {
            "Address": "https://identity.example.com/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "marketing.example.com"
}
